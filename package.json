{
  "name": "savrli-city-v1",
  "version": "1.0.0",
  "description": "Savrli City Restaurant Concierge Application (Flutter Web + Cypress E2E)",
  "private": true,
  "main": "lib/main.dart",
  "scripts": {
    "start": "flutter run -d chrome --web-port=8080",
    "build": "flutter build web --release",
    "serve": "flutter build web --release && npx dhttpd --path build/web --port 8080",
    "test": "flutter test",
    "test:integration": "flutter test integration_test/",
    "lint": "flutter analyze",
    "format": "flutter format .",
    "clean": "flutter clean && flutter pub get",

    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:smoke": "cypress run --spec 'cypress/e2e/smoke_spec.cy.js'",
    "test:e2e": "cypress run --browser chrome",
    "test:e2e:headed": "cypress run --browser chrome --headed",
    "test:e2e:record": "cypress run --record --key $CYPRESS_RECORD_KEY"
  },
  "keywords": [
    "flutter",
    "web",
    "restaurant",
    "concierge",
    "savrli",
    "cypress",
    "e2e"
  ],
  "author": "Kaistable Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "cypress": "^13.15.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}