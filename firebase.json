{
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "restaurantwebsite-4bdd8",
          "configurations": {
            "android": "1:404399548475:android:c7ef5610488496554dd41e",
            "ios": "1:404399548475:ios:6d891f6994bb50284dd41e"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "restaurantwebsite-4bdd8",
          "appId": "1:404399548475:android:c7ef5610488496554dd41e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "restaurantwebsite-4bdd8",
          "appId": "1:404399548475:ios:6d891f6994bb50284dd41e",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ]
}
