# Savrli City V1 Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Environment
NODE_ENV=development
FLUTTER_ENV=development

# API Configuration
API_BASE_URL=https://staging-api.savrli.city/v1
API_TIMEOUT=30000

# Firebase Configuration
FIREBASE_PROJECT_ID=restaurantwebsite-4bdd8
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Cypress Test Configuration
CYPRESS_baseUrl=http://localhost:8080
CYPRESS_API_BASE_URL=https://staging-api.savrli.city/v1

# Deployment Configuration
DEPLOY_TARGET=staging
SKIP_TESTS=false

# Feature Flags
ENABLE_CONCIERGE_ONBOARDING=true
ENABLE_PRIMARY_TASKS=true
ENABLE_NOTIFICATIONS=false

# Third-Party Services (if applicable)
GOOGLE_MAPS_API_KEY=your-maps-api-key
STRIPE_PUBLISHABLE_KEY=your-stripe-key

# Monitoring & Analytics
ENABLE_ANALYTICS=true
SENTRY_DSN=your-sentry-dsn
